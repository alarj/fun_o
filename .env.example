# Replace these before first HTTPS setup.
# Public domain
DOMAIN=example.com
# TLS contact
LETSENCRYPT_EMAIL=admin@example.com

# App
# Runtime mode
APP_ENV=production
# UI languages
LANG_AVAILABLE=et,en
# Default language
LANG_DEFAULT=et
# Default terms dir
CONTENT_DEFAULTS_DIR=/app/frontend_dist/content
# New admin empty-create
ADD_EMPTY_COMPETITION_TO_NEW_ADMIN=false
# Empty-create total cap
MAX_NEW_COMPETITIONS=100
# Admin competition cap
MAX_COMPETITION_ADMIN=10

# ORDS (to be used by FastAPI later)
# ORDS base URL
ORDS_BASE_URL=https://your-adb-host/ords/funo
# ORDS username
ORDS_USERNAME=your_ords_user
# ORDS password
ORDS_PASSWORD=your_ords_password

# Google OAuth (to be used by FastAPI later)
# OAuth client id
GOOGLE_CLIENT_ID=your_google_client_id
# OAuth client secret
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Session signing
SESSION_SECRET=replace_with_a_long_random_string

# Optional map providers for admin map layer selector
# Mapy.cz key
MAPYCZ_API_KEY=
# MapTiler key
MAPTILER_API_KEY=
# MML key
MML_API_KEY=

# Magnetic declination refresh (backend will use this service asynchronously)
# Declination service
DECLINATION_SERVICE_URL_TEMPLATE=http://www.geomag.bgs.ac.uk/web_service/GMModels/wmm/2025/?latitude={latitude}&longitude={longitude}&altitude={altitude}&date={date}&format=json
# Refresh days
DECLINATION_REFRESH_DAYS=30

# Competition overlay storage inside backend container and matching host mount in docker-compose
# Overlay storage dir
OVERLAY_STORAGE_DIR=/app/storage/competition_overlays
# Overlay host dir
OVERLAY_STORAGE_HOST_DIR=/home/ubuntu/fun_o_data/competition_overlays
# Overlay max bytes
OVERLAY_MAX_UPLOAD_BYTES=104857600
# Overlay max size
OVERLAY_MAX_DIMENSION_PX=12000
# Overlay min zoom
OVERLAY_TILE_MIN_ZOOM=5
# Overlay max zoom
OVERLAY_TILE_MAX_ZOOM=14
# Overlay tile token TTL
OVERLAY_TILE_TOKEN_TTL_SECONDS=86400
