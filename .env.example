# Replace these before first HTTPS setup.
# Public domain
DOMAIN=example.com
# TLS contact
LETSENCRYPT_EMAIL=admin@example.com

# App
# Runtime mode
APP_ENV=production
# Backend log level (`ERROR`, `INFO`, `DEBUG`)
# `DEBUG` enables application trace rows while noisy third-party HTTP client logs stay suppressed.
LOG_LEVEL=INFO
# Competitor join anti-bot reCAPTCHA v3
RECAPTCHA_JOIN_V3_SITE_KEY=
# Competitor join anti-bot reCAPTCHA v3
RECAPTCHA_JOIN_V3_SECRET_KEY=
# Competitor join anti-bot reCAPTCHA v2 fallback
RECAPTCHA_JOIN_V2_SITE_KEY=
# Competitor join anti-bot reCAPTCHA v2 fallback
RECAPTCHA_JOIN_V2_SECRET_KEY=
# Competitor join anti-bot expected v3 action
RECAPTCHA_JOIN_V3_ACTION=competitor_join_preview
# Competitor join anti-bot v3 score threshold
RECAPTCHA_JOIN_V3_SCORE_THRESHOLD=0.4
# Competitor join anti-bot join proof TTL seconds
RECAPTCHA_JOIN_PROOF_TTL_SECONDS=900
# Competitor join anti-bot verify endpoint
RECAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify
# UI languages
LANG_AVAILABLE=et,en
# Default language
LANG_DEFAULT=et
# Default terms dir
CONTENT_DEFAULTS_DIR=/app/frontend_dist/content
# New admin empty-create -- kas uuele sisseloginud adminile pakutakse kohe ka uut tühja võistlust 
ADD_EMPTY_COMPETITION_TO_NEW_ADMIN=true
# Empty-create total cap (millise piirini pakutakse uuele adminile tühja võistlust -- spämmi kaitse)
MAX_NEW_COMPETITIONS=100
# Admin competition cap (kui palju võistluseid saab ühel adminil olla -- spämmi kaitse --superadmin privileegi korral ei arvestata)
MAX_COMPETITION_ADMIN=10

# ORDS (used by FastAPI )
# ORDS base URL
ORDS_BASE_URL=https://your-adb-host/ords/funo
# ORDS username
ORDS_USERNAME=your_ords_user
# ORDS password
ORDS_PASSWORD=your_ords_password

# Google OAuth (used by FastAPI )
# OAuth client id
GOOGLE_CLIENT_ID=your_google_client_id
# Session signing
SESSION_SECRET=replace_with_a_long_random_string
# Cookie secure flag
SESSION_COOKIE_SECURE=true
# Admin access cookie
SESSION_COOKIE_NAME=funo_session
# Admin refresh cookie
SESSION_REFRESH_COOKIE_NAME=funo_session_refresh
# Admin access TTL min
SESSION_ACCESS_TTL_MINUTES=60
# Admin refresh TTL days
SESSION_REFRESH_TTL_DAYS=14

# Optional map providers for admin map layer selector
# Mapy.cz key
MAPYCZ_API_KEY=
# MapTiler key
MAPTILER_API_KEY=
# MML (Soome maameti kaardiserver) key
MML_API_KEY=

# Magnetic declination refresh (backend will use this service asynchronously)
# Declination service
DECLINATION_SERVICE_URL_TEMPLATE=http://www.geomag.bgs.ac.uk/web_service/GMModels/wmm/2025/?latitude={latitude}&longitude={longitude}&altitude={altitude}&date={date}&format=json
# Refresh days
DECLINATION_REFRESH_DAYS=30

# Competition overlay storage inside backend container and matching host mount in docker-compose
# Overlay storage dir
OVERLAY_STORAGE_DIR=/app/storage/competition_overlays
# Overlay host dir
OVERLAY_STORAGE_HOST_DIR=/home/ubuntu/fun_o_data/competition_overlays
# Overlay max bytes
OVERLAY_MAX_UPLOAD_BYTES=104857600
# Overlay max size
OVERLAY_MAX_DIMENSION_PX=12000
# Overlay min zoom
OVERLAY_TILE_MIN_ZOOM=5
# Overlay max zoom
OVERLAY_TILE_MAX_ZOOM=14
# Overlay tile token TTL
OVERLAY_TILE_TOKEN_TTL_SECONDS=86400
